\begin{center}
\begin{tabular}{@{}lll@{}}
\toprule
\textbf{State class} & \textbf{Replication} & \textbf{Fresh source on failure} \\
\midrule
Dense / shared      & DP-replicated & Healthy DP peer (step $t$) \\
Router              & DP-replicated & Healthy DP peer (step $t$) \\
Expert weights      & EP-sharded    & Per-rank checkpoint shard (step $c<t$) \\
Expert optimizer    & EP-sharded    & Per-rank checkpoint shard (step $c<t$) \\
