  & \cellcolor{green!12}\makecell{4.8712\\\scriptsize$+0.71\sigma$}
  & \cellcolor{red!12}\makecell{4.8883\\\scriptsize$+1.42\sigma$}
  & \cellcolor{red!12}\makecell{4.8892\\\scriptsize$+1.46\sigma$} \\
